# Supabase is needed for login and saving records. The dev OCR demo works without it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional cloud reader. Keep this key on the Next.js server; never use NEXT_PUBLIC_ here.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-omni-flash
